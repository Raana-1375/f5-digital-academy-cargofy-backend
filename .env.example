# Copy this file to .env and replace the values. The .env file is git-ignored.

# Database (used by docker-compose.yml and by the application)
DB_ROOT_PASSWORD=choose-a-root-password
DB_USER=cargofy_user
DB_PASSWORD=choose-a-database-password

# Secret key used to sign the JWT tokens (Base64, at least 256 bits)
JWT_SECRET=generate-a-base64-key

# Demo accounts created at startup
DEMO_PASSWORD=choose-a-demo-password

# Operators can only register with this code
OPERATOR_ACCESS_CODE=choose-an-operator-access-code